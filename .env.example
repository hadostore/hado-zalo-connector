# ===== Bắt buộc =====
# Lấy ở developers.zalo.me > ứng dụng của bạn > Thông tin ứng dụng
ZALO_APP_ID=
ZALO_APP_SECRET=

# URL công khai của server sau khi deploy (không có dấu / ở cuối)
# Ví dụ: https://hado-zalo.onrender.com
PUBLIC_BASE_URL=

# Chuỗi bí mật dài, ngẫu nhiên. Nằm trong URL connector: <PUBLIC_BASE_URL>/mcp/<MCP_SECRET>
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_SECRET=

# Mật khẩu để mở trang cấp quyền OA: <PUBLIC_BASE_URL>/oauth/start?key=<ADMIN_KEY>
ADMIN_KEY=

# ===== An toàn khi gửi tin =====
# false (mặc định): các tool gửi tin chỉ trả bản xem trước, KHÔNG gửi thật.
# Chỉ đổi sang true khi anh đã thử xong và muốn cho phép gửi tin thật cho khách.
ZALO_SEND_ENABLED=false

# ===== Tuỳ chọn =====
# Mã xác thực domain Zalo cấp (Zalo > Xác thực domain). Server sẽ tự hiển thị meta tag và file zalo_verifier<MÃ>.html
ZALO_VERIFY_CODE=

# OA Secret Key (Zalo > Webhook) để kiểm tra chữ ký webhook. Để trống thì bỏ qua kiểm tra.
ZALO_OA_SECRET_KEY=

# Lưu token: nếu host không có ổ đĩa bền (Render free...), dùng Upstash Redis (miễn phí)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Nếu không dùng Upstash, token lưu vào file trong thư mục này (cần ổ đĩa bền)
DATA_DIR=./data

PORT=3000
